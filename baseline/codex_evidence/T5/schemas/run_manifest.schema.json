{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ndagisports.local/hp001/t5/run_manifest.schema.json",
  "title": "HP-001 T5 run manifest",
  "type": "object",
  "required": ["schema_version", "record_type", "run_id", "configuration", "classification", "outcome", "determinism", "telemetry", "environment_provenance"],
  "properties": {
    "schema_version": {"const": "hp001-t5-v1"},
    "record_type": {"const": "run_manifest"},
    "run_id": {"type": "string"},
    "classification": {
      "type": "object",
      "required": ["category", "terminal", "completed_regulation", "early_termination", "censored", "eligible_regulation_throughput"],
      "properties": {
        "category": {"enum": ["completed_regulation", "completed_short_regulation", "completed_overtime", "completed_shootout", "forfeit", "timeout", "error", "engine_watchdog", "other_incomplete", "other_terminal"]},
        "terminal": {"type": "boolean"},
        "completed_regulation": {"type": "boolean"},
        "early_termination": {"type": "boolean"},
        "censored": {"type": "boolean"},
        "eligible_regulation_throughput": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "outcome": {"type": "object"},
    "determinism": {"type": "object"},
    "telemetry": {"type": "object"},
    "environment_provenance": {"type": "object"}
  },
  "additionalProperties": true
}
