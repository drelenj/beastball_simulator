{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ndagisports.local/hp001/t5/experiment.schema.json",
  "title": "HP-001 T5 experiment batch specification",
  "type": "object",
  "required": ["experiment_id", "mode", "seeds", "arms", "base_config"],
  "properties": {
    "experiment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "mode": {"enum": ["independent", "paired"]},
    "baseline_arm": {"type": "string"},
    "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
    "base_config": {"type": "object"},
    "arms": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["arm_id"],
        "properties": {"arm_id": {"type": "string"}, "config": {"type": "object"}},
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
